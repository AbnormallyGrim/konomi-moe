{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "engine/**",
      "ui/**",
      "seanime/**",
      "extension/**",
      "*.json",
      "!**/node_modules",
      "!lab",
      "!design",
      "!graft",
      "!.trail",
      "!engine/test/fixtures",
      "!**/dist",
      "!seanime/release"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
